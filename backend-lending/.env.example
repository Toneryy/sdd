# Database Configuration (используется для knex/legacy)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Prisma Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/your_database?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=2d

# Encryption Key
# IMPORTANT: This MUST match the CRYPTO_SECRET in admin-panel/backend/.env
# Both backends must use the same key to encrypt/decrypt user data
ENCRYPTION_KEY=your-encryption-key-exactly-32-chars

# Business Logic Configuration
# Время резервирования товара в корзине (мс) - default: 5 минут
RESERVE_TTL_MS=300000

# Максимум единиц одного товара на пользователя
MAX_PER_PRODUCT_PER_USER=3

# Окно для возврата товара (мс) - default: 24 часа
REFUND_WINDOW_MS=86400000

# Jobs Configuration
# 0 = enabled, 1 = disabled
JOBS_DISABLED=0

# CORS Configuration (optional)
FRONTEND_URL=http://localhost:3000

# Optional: Logging
LOG_LEVEL=debug